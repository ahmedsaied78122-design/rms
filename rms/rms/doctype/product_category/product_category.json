{
  "doctype": "DocType",
  "name": "Product Category",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "category_section",
    "title",
    "image",
    "parent_product_category",
    "sequence_id",
    "enabled",
    "defaults_section",
    "is_group",
    "item_group",
    "default_warehouse",
    "default_preparation_area",
    "lft",
    "rgt",
    "old_parent"
  ],
  "fields": [
    {
      "fieldname": "category_section",
      "fieldtype": "Section Break",
      "label": "Category"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Category Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 4
    },
    {
      "fieldname": "image",
      "fieldtype": "Attach Image",
      "label": "Category Image"
    },
    {
      "fieldname": "parent_product_category",
      "fieldtype": "Link",
      "label": "Parent Category",
      "options": "Product Category",
      "in_standard_filter": 1,
      "link_filters": "[[\"Product Category\",\"enabled\",\"=\",\"1\"],[\"Product Category\",\"is_group\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "sequence_id",
      "fieldtype": "Int",
      "label": "Sequence ID",
      "default": "0",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "defaults_section",
      "fieldtype": "Section Break",
      "label": "Product Defaults"
    },
    {
      "fieldname": "is_group",
      "fieldtype": "Check",
      "label": "Is Group",
      "default": "0",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "item_group",
      "fieldtype": "Link",
      "label": "Item Group",
      "options": "Item Group",
      "link_filters": "[[\"Item Group\",\"is_group\",\"=\",\"0\"]]"
    },
    {
      "fieldname": "default_warehouse",
      "fieldtype": "Link",
      "label": "Default Warehouse",
      "options": "Warehouse",
      "link_filters": "[[\"Warehouse\",\"is_group\",\"=\",\"0\"],[\"Warehouse\",\"disabled\",\"=\",\"0\"]]"
    },
    {
      "fieldname": "default_preparation_area",
      "fieldtype": "Link",
      "label": "Default Preparation Area",
      "options": "Preparation Area",
      "link_filters": "[[\"Preparation Area\",\"enabled\",\"=\",\"1\"]]"
    },
    {
      "fieldname": "lft",
      "fieldtype": "Int",
      "hidden": 1,
      "label": "lft",
      "no_copy": 1,
      "read_only": 1,
      "print_hide": 1
    },
    {
      "fieldname": "rgt",
      "fieldtype": "Int",
      "hidden": 1,
      "label": "rgt",
      "no_copy": 1,
      "read_only": 1,
      "print_hide": 1
    },
    {
      "fieldname": "old_parent",
      "fieldtype": "Link",
      "label": "Old Parent",
      "options": "Product Category",
      "hidden": 1,
      "no_copy": 1,
      "read_only": 1,
      "ignore_user_permissions": 1,
      "print_hide": 1,
      "report_hide": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ],
  "is_tree": 1,
  "nsm_parent_field": "parent_product_category"
}
