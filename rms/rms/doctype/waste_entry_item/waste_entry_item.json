{
  "doctype": "DocType",
  "name": "Waste Entry Item",
  "module": "RMS",
  "istable": 1,
  "engine": "InnoDB",
  "field_order": [
    "item",
    "qty",
    "uom",
    "basic_rate",
    "amount",
    "warehouse"
  ],
  "fields": [
    {
      "fieldname": "item",
      "fieldtype": "Link",
      "label": "Item",
      "options": "Item",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2,
      "link_filters": "[[\"Item\",\"is_stock_item\",\"=\",\"1\"],[\"Item\",\"disabled\",\"=\",\"0\"]]"
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "Quantity",
      "reqd": 1,
      "non_negative": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "UOM",
      "options": "UOM",
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "basic_rate",
      "fieldtype": "Currency",
      "label": "Rate",
      "in_list_view": 1,
      "columns": 2,
      "fetch_from": "item.valuation_rate",
      "read_only": 1
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Amount",
      "in_list_view": 1,
      "columns": 2,
      "read_only": 1
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Warehouse",
      "options": "Warehouse",
      "reqd": 1,
      "read_only": 1,
      "link_filters": "[[\"Warehouse\",\"company\",\"=\",\"eval:parent.store_company\"],[\"Warehouse\",\"is_group\",\"=\",\"0\"],[\"Warehouse\",\"disabled\",\"=\",\"0\"]]"
    }
  ],
  "permissions": []
}
