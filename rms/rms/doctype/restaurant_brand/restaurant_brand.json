{
  "doctype": "DocType",
  "name": "Restaurant Brand",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "brand_section",
    "title",
    "brand_code",
    "enabled",
    "pos_rounding_method",
    "brand_image",
    "menus_section",
    "menus"
  ],
  "fields": [
    {
      "fieldname": "brand_section",
      "fieldtype": "Section Break",
      "label": "Brand"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Brand Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 4
    },
    {
      "fieldname": "brand_code",
      "fieldtype": "Data",
      "label": "Brand Code",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "pos_rounding_method",
      "fieldtype": "Select",
      "label": "POS Rounding Method",
    "options": "No Rounding\nRound Up\nNearest\nRound Down",
      "default": "Nearest",
      "description": "Controls whole-EGP rounding for the final POS payable."
    },
    {
      "fieldname": "brand_image",
      "fieldtype": "Attach Image",
      "label": "Brand Image"
    },
    {
      "fieldname": "menus_section",
      "fieldtype": "Section Break",
      "label": "Menus"
    },
    {
      "fieldname": "menus",
      "fieldtype": "Table",
      "label": "Menus",
      "options": "Brand Menu Assignment"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ]
}
