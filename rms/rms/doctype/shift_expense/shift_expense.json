{
  "doctype": "DocType",
  "name": "Shift Expense",
  "module": "RMS",
  "engine": "InnoDB",
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "title_field": "name",
  "search_fields": "cashier_session,expense_category,mode_of_payment",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": ["naming_series", "overview_section", "status", "cashier_session", "store", "company", "cashier", "business_date", "currency", "expense_section", "expense_category", "expense_account", "cost_center", "mode_of_payment", "payment_account", "amount", "remarks", "attachment", "posting_section", "journal_entry", "approver", "approved_at", "rejected_by", "rejected_at", "rejection_reason"],
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "RMS-EXP-.YYYY.-", "default": "RMS-EXP-.YYYY.-", "hidden": 1},
    {"fieldname": "overview_section", "fieldtype": "Section Break", "label": "Shift Expense"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nPending Approval\nPosted\nRejected", "default": "Draft", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1, "columns": 1},
    {"fieldname": "cashier_session", "fieldtype": "Link", "label": "Cashier Session", "options": "Cashier Session", "reqd": 1, "read_only": 1, "in_list_view": 1, "in_standard_filter": 1, "columns": 2},
    {"fieldname": "store", "fieldtype": "Link", "label": "Store", "options": "Store", "reqd": 1, "read_only": 1, "fetch_from": "cashier_session.store", "in_list_view": 1, "columns": 2},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1, "read_only": 1, "fetch_from": "store.company"},
    {"fieldname": "cashier", "fieldtype": "Link", "label": "Cashier", "options": "User", "reqd": 1, "read_only": 1, "fetch_from": "cashier_session.user"},
    {"fieldname": "business_date", "fieldtype": "Date", "label": "Business Date", "reqd": 1, "read_only": 1, "fetch_from": "cashier_session.business_date"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "reqd": 1, "read_only": 1, "fetch_from": "company.default_currency"},
    {"fieldname": "expense_section", "fieldtype": "Section Break", "label": "Expense Details"},
    {"fieldname": "expense_category", "fieldtype": "Link", "label": "Expense Category", "options": "Expense Category", "reqd": 1, "in_list_view": 1, "columns": 2, "link_filters": "[[\"Expense Category\",\"company\",\"=\",\"eval:doc.company\"],[\"Expense Category\",\"enabled\",\"=\",\"1\"]]"},
    {"fieldname": "expense_account", "fieldtype": "Link", "label": "Expense Account", "options": "Account", "reqd": 1, "read_only": 1, "fetch_from": "expense_category.expense_account", "link_filters": "[[\"Account\",\"company\",\"=\",\"eval:doc.company\"]]"},
    {"fieldname": "cost_center", "fieldtype": "Link", "label": "Cost Center", "options": "Cost Center", "read_only": 1, "fetch_from": "expense_category.cost_center"},
    {"fieldname": "mode_of_payment", "fieldtype": "Link", "label": "Mode of Payment", "options": "Mode of Payment", "reqd": 1},
    {"fieldname": "payment_account", "fieldtype": "Link", "label": "Payment Account", "options": "Account", "reqd": 1, "read_only": 1},
    {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "options": "currency", "reqd": 1, "in_list_view": 1, "columns": 2},
    {"fieldname": "remarks", "fieldtype": "Small Text", "label": "Notes"},
    {"fieldname": "attachment", "fieldtype": "Attach", "label": "Receipt Attachment"},
    {"fieldname": "posting_section", "fieldtype": "Section Break", "label": "Accounting"},
    {"fieldname": "journal_entry", "fieldtype": "Link", "label": "Journal Entry", "options": "Journal Entry", "read_only": 1},
    {"fieldname": "approver", "fieldtype": "Link", "label": "Approved By", "options": "User", "read_only": 1},
    {"fieldname": "approved_at", "fieldtype": "Datetime", "label": "Approved At", "read_only": 1},
    {"fieldname": "rejected_by", "fieldtype": "Link", "label": "Rejected By", "options": "User", "read_only": 1},
    {"fieldname": "rejected_at", "fieldtype": "Datetime", "label": "Rejected At", "read_only": 1},
    {"fieldname": "rejection_reason", "fieldtype": "Small Text", "label": "Rejection Reason", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
    {"role": "POS Manager", "read": 1, "write": 1, "create": 1, "report": 1},
    {"role": "POS Cashier", "read": 1}
  ]
}
