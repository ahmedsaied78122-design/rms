{
  "doctype": "DocType",
  "name": "Order Type",
  "module": "RMS",
  "engine": "InnoDB",
  "allow_rename": 1,
  "autoname": "field:title",
  "naming_rule": "By fieldname",
  "title_field": "title",
  "search_fields": "title",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "field_order": [
    "identity_section",
    "title",
    "enabled",
    "sequence_id",
    "identity_column",
    "delivery_included",
    "require_table",
    "require_external_reference",
    "accounting_section",
    "accounts"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "Order Type"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 4
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "columns": 2
    },
    {
      "fieldname": "sequence_id",
      "fieldtype": "Int",
      "label": "Sequence ID",
      "default": "0",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "identity_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "delivery_included",
      "fieldtype": "Check",
      "label": "Delivery Included",
      "default": "0"
    },
    {
      "fieldname": "require_table",
      "fieldtype": "Check",
      "label": "Require Table",
      "default": "0"
    },
    {
      "fieldname": "require_external_reference",
      "fieldtype": "Check",
      "label": "Require External Reference",
      "default": "0"
    },
    {
      "fieldname": "accounting_section",
      "fieldtype": "Section Break",
      "label": "Accounts"
    },
    {
      "fieldname": "accounts",
      "fieldtype": "Table",
      "label": "Accounts",
      "options": "Order Type Account Mapping"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "report": 1
    }
  ]
}
