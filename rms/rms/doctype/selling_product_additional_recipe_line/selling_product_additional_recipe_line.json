{
  "doctype": "DocType",
  "name": "Selling Product Additional Recipe Line",
  "module": "RMS",
  "istable": 1,
  "engine": "InnoDB",
  "field_order": [
    "item",
    "qty",
    "uom",
    "cost",
    "order_types"
  ],
  "fields": [
    {
      "fieldname": "item",
      "fieldtype": "Link",
      "label": "Item",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2,
      "link_filters": "[[\"Item\",\"is_stock_item\",\"=\",\"1\"],[\"Item\",\"disabled\",\"=\",\"0\"]]"
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "Quantity",
      "reqd": 1,
      "non_negative": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "UOM",
      "options": "UOM",
      "fetch_from": "item.stock_uom",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "cost",
      "fieldtype": "Currency",
      "label": "Cost",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2,
      "fetch_from": "item.valuation_rate"
    },
    {
      "fieldname": "order_types",
      "fieldtype": "MultiSelect",
      "label": "Order Types",
      "options": "",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2,
      "description": "Select enabled Order Types. Choices are loaded from the Order Type records."
    }
  ],
  "permissions": []
}
